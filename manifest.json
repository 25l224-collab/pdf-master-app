{
  "id": "/pdf-master-app/",
  "name": "PDF Master Pro Studio",
  "short_name": "PDF Master",
  "description": "All-in-One Online & Mobile PDF Suite. Convert, Merge, Split, Sign & Protect PDFs with 100% client-side privacy.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#4f46e5",
  "background_color": "#0a0f1d",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "auto"
  },
  "file_handlers": [
    {
      "action": "./",
      "name": "PDF and Document Files",
      "accept": {
        "application/pdf": [".pdf"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"]
      }
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "PDF Master Studio Desktop Experience"
    },
    {
      "src": "screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "PDF Master Studio Mobile Experience"
    }
  ],
  "categories": ["productivity", "utilities", "business"],
  "shortcuts": [
    {
      "name": "Scan Document",
      "short_name": "Scan",
      "description": "Scan a physical document using camera",
      "url": "./#scanner"
    },
    {
      "name": "Merge PDFs",
      "short_name": "Merge",
      "description": "Merge multiple PDF files into one",
      "url": "./#tool-merge"
    }
  ]
}
